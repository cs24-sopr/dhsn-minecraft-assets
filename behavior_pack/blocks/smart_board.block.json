{
    "format_version": "1.26.50",
    "minecraft:block": {
        "description": {
            "identifier": "myname:smart_board",
            "menu_category": {
                "category": "construction"
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": ["minecraft:cardinal_direction"]
                }
            },
            "states": {
                "myname:smart_board_part": [0, 1, 2, 3, 4, 5],
                "myname:smart_board_width": ["east", "west", "north", "south"]
            }
        },
        "components": {
            "minecraft:collision_box": {
                "origin": [-8, 0, 1],
                "size": [16, 16, 7]
            },
            "minecraft:selection_box": {
                "origin": [-8, 0, 1],
                "size": [16, 16, 7]
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 1
            },
            "minecraft:destructible_by_explosion": false,
            "minecraft:geometry": "geometry.smart_board_middle",
            "minecraft:material_instances": {
                "*": {
                    "texture": "smart_board",
                    "render_method": "opaque"
                }
            },
            "minecraft:map_color": "#3a3c3d",
            "minecraft:redstone_conductivity": {
                "redstone_conductor": true
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('myname:smart_board_part') == 0",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_left"
                }
            },
            {
                "condition": "q.block_state('myname:smart_board_part') == 1",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_middle"
                }
            },
            {
                "condition": "q.block_state('myname:smart_board_part') == 2",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_right"
                }
            },
            {
                "condition": "q.block_state('myname:smart_board_part') == 3",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_top_left"
                }
            },
            {
                "condition": "q.block_state('myname:smart_board_part') == 4",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_top_middle"
                }
            },
            {
                "condition": "q.block_state('myname:smart_board_part') == 5",
                "components": {
                    "minecraft:geometry": "geometry.smart_board_top_right"
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 180, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 0, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 90, 0]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [0, 270, 0]
                    }
                }
            }
